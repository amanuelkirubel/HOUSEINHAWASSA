# Copy this file to .env and fill in your real values.
# Never commit your real .env file.

# Your PostgreSQL connection string (from Supabase, Render, or Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# A long random string used to sign login sessions - change this to anything unique
JWT_SECRET=change-this-to-a-long-random-string

# Port the server runs on (most hosts set this automatically)
PORT=3000
