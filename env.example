# Copy this file to .env and fill in your real values.
# Never commit your real .env file.

# Your PostgreSQL connection string from Supabase (Project Settings -> Database
# -> Connection string -> URI, under Connection pooling). Listings and users
# are stored here — this is what makes data survive server restarts.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Your Supabase project URL and service_role secret key (Project Settings -> API).
# Used to upload listing photos to Supabase Storage so they also survive
# restarts. If left blank, photos still work but are stored as base64 inside
# the database instead, which is heavier — filling these in is recommended.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Name of the public Supabase Storage bucket to upload listing photos into.
# Create this bucket in Supabase (Storage -> New bucket) and mark it Public.
SUPABASE_PHOTO_BUCKET=listing-photos

# A long random string used to sign login sessions - change this to anything unique
JWT_SECRET=change-this-to-a-long-random-string

# Port the server runs on (most hosts set this automatically)
PORT=3000
